# Obtain from https://my.telegram.org/apps (never send these values to anyone)
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Token for a NEW control bot created with @BotFather
CONTROL_BOT_TOKEN=
# Optional: sanity check ID. The actual owner is always the account logged into the separate session.
# OWNER_TELEGRAM_ID=
DATA_DIR=/data
MAX_FILE_MB=300
MIN_FREE_MB=1024
# Default false: never duplicate private media to a bot unless you explicitly opt in
ENABLE_BOT_DELIVERY=false
BOT_SEND_MAX_MB=45

# Explicit opt-in: new groups start archiving AFTER the bot announces it publicly
AUTO_ARCHIVE_GROUPS=false
